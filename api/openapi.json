{
  "openapi": "3.1.0",
  "info": {
    "title": "Aditya Sudhakar Portfolio API",
    "version": "1.0.0",
    "description": "Read-only, static JSON about Aditya Sudhakar and selected public work. No authentication or rate-limited server process is involved."
  },
  "servers": [
    {
      "url": "https://adityasudhakar.com"
    }
  ],
  "paths": {
    "/api/profile.json": {
      "get": {
        "operationId": "getProfile",
        "summary": "Get Aditya's public profile",
        "responses": {
          "200": {
            "description": "Public profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects.json": {
      "get": {
        "operationId": "listProjects",
        "summary": "List selected public work",
        "responses": {
          "200": {
            "description": "Project catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["schema_version", "updated_at", "projects"],
                  "properties": {
                    "schema_version": { "type": "string" },
                    "updated_at": { "type": "string", "format": "date" },
                    "projects": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Project" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/knowledge.json": {
      "get": {
        "operationId": "getPublicKnowledge",
        "summary": "Get collated public website, GitHub, and career content for agents and the CLI",
        "responses": {
          "200": {
            "description": "Website text, public GitHub repository metadata and README excerpts, and the owner-maintained career record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["schema_version", "generated_at", "sources", "documents"],
                  "properties": {
                    "schema_version": { "type": "string" },
                    "generated_at": { "type": "string", "format": "date-time" },
                    "description": { "type": "string" },
                    "sources": { "type": "object", "additionalProperties": { "type": "string" } },
                    "documents": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/KnowledgeDocument" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "required": ["schema_version", "updated_at", "name", "summary", "links"],
        "properties": {
          "schema_version": { "type": "string" },
          "updated_at": { "type": "string", "format": "date" },
          "name": { "type": "string" },
          "summary": { "type": "string" },
          "location": { "type": "object", "additionalProperties": true },
          "background": { "type": "array", "items": { "type": "string" } },
          "interests": { "type": "array", "items": { "type": "string" } },
          "links": { "type": "object", "additionalProperties": { "type": "string" } },
          "agent_interfaces": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      },
      "Project": {
        "type": "object",
        "required": ["slug", "name", "status", "summary", "topics", "links"],
        "properties": {
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "status": { "type": "string" },
          "year": { "type": "integer" },
          "summary": { "type": "string" },
          "details": { "type": "array", "items": { "type": "string" } },
          "topics": { "type": "array", "items": { "type": "string" } },
          "stack": { "type": "array", "items": { "type": "string" } },
          "links": { "type": "object", "additionalProperties": { "type": "string", "format": "uri" } }
        }
      },
      "KnowledgeDocument": {
        "type": "object",
        "required": ["id", "source", "title", "url", "tags", "content"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string", "enum": ["website", "github", "career"] },
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "content": { "type": "string" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      }
    }
  }
}
